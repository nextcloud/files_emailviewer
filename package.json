{
  "name": "files_emailviewer",
  "description": "Email viewer plugin for Nextcloud",
  "version": "0.2.0",
  "bugs": {
    "url": "https://github.com/nextcloud/files_emailviewer/issues"
  },
  "repository": {
    "url": "https://github.com/nextcloud/files_emailviewer",
    "type": "git"
  },
  "homepage": "https://github.com/nextcloud/files_emailviewer",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "scripts": {
    "build": "npm run generate:codepages && npm run typecheck && webpack --node-env production --progress",
    "dev": "npm run generate:codepages && webpack --node-env development --progress",
    "watch": "npm run generate:codepages && webpack --node-env development --progress --watch",
    "generate:codepages": "node generateCodepageMapping.mts",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:browser": "playwright test -c tests/javascript/browser/playwright.config.ts"
  },
  "dependencies": {
    "@kenjiuno/msgreader": "^1.29.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/logger": "^3.0.3",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^8.41.0",
    "@zumer/snapdom": "^3.3.5",
    "@zumer/snapdom-plugins": "^4.0.2",
    "dompurify": "^3.4.17",
    "postal-mime": "^4.0.11",
    "vue": "^2.7.16"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.3.0"
  },
  "devDependencies": {
    "@nextcloud/babel-config": "^1.3.0",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/webpack-vue-config": "^7.0.2",
    "@playwright/test": "^1.64.1",
    "@tutao/oxmsg": "^0.2.3",
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "vue-loader": "^15.11.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
